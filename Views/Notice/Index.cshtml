@model List<StudentPortal.Models.Notice>
@{
    ViewData["Title"] = "Notices";
}

<div class="mb-4">
    <h3 class="mb-0">Notices & Announcements</h3>
    <small class="text-muted">Stay updated with latest information</small>
</div>

<div class="row mb-4">
    @if (Model.Any())
    {
        @foreach (var notice in Model.OrderByDescending(n => n.CreatedAt))
        {
            var categoryColor = notice.Category switch
            {
                "Exam" => "#ef4444",
                "Sports" => "#10b981",
                "Events" => "#8b5cf6",
                _ => "#6b7280"
            };

            <div class="col-md-6 col-lg-4">
                <div class="card" style="border-left: 4px solid @categoryColor">
                    <div class="card-body">
                        <div class="mb-2">
                            <span class="badge" style="background-color: @categoryColor">@notice.Category</span>
                            <small class="text-muted float-end">@notice.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</small>
                        </div>
                        <h6 class="card-title">@notice.Title</h6>
                        <p class="card-text text-muted text-sm">@notice.Content.Substring(0, Math.Min(120, notice.Content.Length))...</p>
                        <a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#noticeModal@notice.NoticeId">Read More</a>
                    </div>
                </div>
            </div>

            <!-- Modal -->
            <div class="modal fade" id="noticeModal@notice.NoticeId" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">@notice.Title</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p><strong>Category:</strong> <span class="badge" style="background-color: @categoryColor">@notice.Category</span></p>
                            <p><strong>Date:</strong> @notice.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</p>
                            <hr />
                            <p>@notice.Content</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center py-5" role="alert">
                <i class="bi bi-info-circle" style="font-size:32px;display:block;margin-bottom:1rem;opacity:0.5"></i>
                <p>No notices available at the moment</p>
            </div>
        </div>
    }
</div>
