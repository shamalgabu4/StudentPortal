@model StudentPortal.Models.Enrollment
@{
    ViewData["Title"] = "Enroll Student";
}

<div class="card" style="max-width:720px">
    <div class="card-body">
        <h5 class="mb-3">Enroll Student</h5>
        <form id="enrollForm" asp-action="Create" method="post">
            @if(!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error:</strong>
                    @foreach(var modelState in ViewData.ModelState.Values)
                    {
                        @foreach(var error in modelState.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <div class="mb-3 form-floating">
                <select asp-for="StudentId" class="form-select" required asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Students, "StudentId", "Name"))">
                    <option selected disabled>-- Select Student --</option>
                </select>
                <label>Student</label>
            </div>
            <div class="mb-3 form-floating">
                <select asp-for="CourseId" class="form-select" required asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Courses, "CourseId", "Name"))">
                    <option selected disabled>-- Select Course --</option>
                </select>
                <label>Course</label>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary" type="submit">Enroll</button>
            </div>
        </form>
    </div>
</div>
