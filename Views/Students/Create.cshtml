@model StudentPortal.Models.Student
@{
    ViewData["Title"] = "Add Student";
}

<div class="card" style="max-width:720px">
    <div class="card-body">
        <h5 class="mb-3">Add Student</h5>
        <form id="studentForm" asp-action="Create" method="post">
            <div class="row g-3">
                <div class="col-md-6 form-floating">
                    <input asp-for="Name" class="form-control" placeholder="Name" required minlength="2" />
                    <label asp-for="Name">Name</label>
                    <div class="invalid-feedback d-block" style="font-size:0.875rem;color:#dc3545;margin-top:0.25rem;display:none">Name is required (min 2 characters)</div>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="Email" class="form-control" placeholder="Email" type="email" required />
                    <label asp-for="Email">Email</label>
                    <div class="invalid-feedback d-block" style="font-size:0.875rem;color:#dc3545;margin-top:0.25rem;display:none">Please enter a valid email address</div>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="Phone" class="form-control" placeholder="Phone" pattern="[0-9]{10}" title="Phone must be 10 digits" />
                    <label asp-for="Phone">Phone</label>
                    <div class="invalid-feedback d-block" style="font-size:0.875rem;color:#dc3545;margin-top:0.25rem;display:none">Phone must be exactly 10 digits</div>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="Course" class="form-control" placeholder="Course" />
                    <label asp-for="Course">Course</label>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="DateOfBirth" type="date" class="form-control" placeholder="DOB" />
                    <label asp-for="DateOfBirth">Date of birth</label>
                </div>
            </div>
            <div class="mt-3">
                <button id="submitBtn" class="btn btn-primary" type="submit" disabled>Save</button>
            </div>
        </form>
    </div>
</div>

<div id="successToast" class="position-fixed" style="bottom:2rem;right:2rem;z-index:1050;display:none">
    <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white">
            <i class="bi bi-check-circle me-2"></i>
            <strong class="me-auto">Success</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            Student added successfully!
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        const form = document.getElementById('studentForm');
        const submitBtn = document.getElementById('submitBtn');
        const inputs = form.querySelectorAll('input[required], input[type="email"], input[pattern]');

        // Function to validate form and enable/disable submit button
        function validateForm(){
            let isValid = form.checkValidity() === true;
            submitBtn.disabled = !isValid;
        }

        // Add listeners to all inputs to validate on change
        inputs.forEach(input => {
            input.addEventListener('input', validateForm);
            input.addEventListener('change', validateForm);
        });

        // Initial validation
        validateForm();

        // Show success toast on successful submission
        form.addEventListener('submit', function(e){
            if(form.checkValidity() === false){
                e.preventDefault();
                e.stopPropagation();
                form.classList.add('was-validated');
            }else{
                // Form is valid; show toast notification
                var toastEl = document.getElementById('successToast');
                toastEl.style.display = 'block';
                setTimeout(() => {
                    toastEl.style.display = 'none';
                }, 3000);
            }
        });
    </script>
}
