@model StudentPortal.Models.Student
@{
    ViewData["Title"] = "Edit Student";
}

<div class="card" style="max-width:720px">
    <div class="card-body">
        <h5 class="mb-3">Edit Student</h5>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="StudentId" />
            <div class="row g-3">
                <div class="col-md-6 form-floating">
                    <input asp-for="Name" class="form-control" placeholder="Name" />
                    <label asp-for="Name">Name</label>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="Email" class="form-control" placeholder="Email" />
                    <label asp-for="Email">Email</label>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="Phone" class="form-control" placeholder="Phone" />
                    <label asp-for="Phone">Phone</label>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="Course" class="form-control" placeholder="Course" />
                    <label asp-for="Course">Course</label>
                </div>
                <div class="col-md-6 form-floating">
                    <input asp-for="DateOfBirth" type="date" class="form-control" placeholder="DOB" />
                    <label asp-for="DateOfBirth">Date of birth</label>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts{<partial name="_ValidationScriptsPartial" />}
