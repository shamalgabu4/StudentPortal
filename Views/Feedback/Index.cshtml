@model IEnumerable<StudentPortal.Models.Feedback>
@{
    ViewData["Title"] = "Feedback List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0">Feedback</h3>
        <small class="text-muted">View all submitted feedback</small>
    </div>
    <a class="btn btn-primary btn-sm" asp-action="Create">+ New Feedback</a>
</div>

@if (!Model.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-inbox" style="font-size:48px;color:var(--muted);margin-bottom:1rem;display:block"></i>
            <h5 class="text-muted">No feedback yet</h5>
            <p class="text-muted">There is no feedback to display.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach(var f in Model){
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="mb-1">@f.Name</h6>
                                <a href="mailto:@f.Email" class="text-muted text-decoration-none small">@f.Email</a>
                            </div>
                            <span class="badge bg-light text-muted small">@f.SubmittedOn.ToLocalTime().ToString("MMM dd, yyyy")</span>
                        </div>
                        <p class="mt-3 mb-0">@f.Message</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
