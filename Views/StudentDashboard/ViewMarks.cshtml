@model List<StudentPortal.Models.Marks>
@{
    ViewData["Title"] = "Semester Results";
    var semester = ViewBag.Semester as StudentPortal.Models.Semester;
    var totalMarks = ViewBag.TotalMarks;
    decimal avg;
    var avgMarks = decimal.TryParse(ViewBag.AverageMarks?.ToString(), out avg) ? avg : 0m;
}

<div class="mb-4">
    <a href="@Url.Action("Results", "StudentDashboard")" class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i> Back</a>
    <h2 class="mt-3 mb-0"><i class="bi bi-graph-up"></i> Semester @semester?.SemesterNumber Results</h2>
    <small class="text-muted">Detailed marks and grades for each subject</small>
</div>

<!-- Stats Summary -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label"><i class="bi bi-book"></i> Total Subjects</div>
            <div class="stat-number">@Model.Count</div>
            <small class="text-muted">Enrolled</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card success">
            <div class="stat-label"><i class="bi bi-calculator"></i> Total Marks</div>
            <div class="stat-number">@totalMarks.ToString("F2")</div>
            <small class="text-muted">Out of @(Model.Sum(m => m.Subject!.MaxMarks))</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card info">
            <div class="stat-label"><i class="bi bi-bar-chart"></i> Average Marks</div>
            <div class="stat-number">@avgMarks.ToString("F2")</div>
            <small class="text-muted">Per subject</small>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-table"></i> Subject-wise Performance</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-book-half"></i> Subject</th>
                    <th><i class="bi bi-code"></i> Code</th>
                    <th><i class="bi bi-list-ol"></i> Max</th>
                    <th><i class="bi bi-check2-circle"></i> Obtained</th>
                    <th><i class="bi bi-percent"></i> %</th>
                    <th><i class="bi bi-star"></i> Grade</th>
                    <th><i class="bi bi-flag"></i> Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mark in Model.OrderBy(m => m.Subject!.Name))
                {
                    var percentage = (mark.ObtainedMarks / mark.Subject!.MaxMarks) * 100;
                    <tr>
                        <td><strong>@mark.Subject.Name</strong></td>
                        <td><small>@mark.Subject.Code</small></td>
                        <td>@mark.Subject.MaxMarks</td>
                        <td><strong>@mark.ObtainedMarks.ToString("F2")</strong></td>
                        <td>
                            <span class="font-weight-600">@percentage.ToString("F1")%</span>
                        </td>
                        <td>
                            <span class="badge" style="@GetGradeColor(mark.Grade)">@mark.Grade</span>
                        </td>
                        <td>
                            @if (mark.IsPassed)
                            {
                                <span class="badge bg-success">✓ Passed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">✗ Failed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private string GetGradeColor(string grade)
    {
        return grade switch
        {
            "A+" => "background-color: #10b981; color: white;",
            "A" => "background-color: #059669; color: white;",
            "B+" => "background-color: #0891b2; color: white;",
            "B" => "background-color: #06b6d4; color: white;",
            "C+" => "background-color: #f59e0b; color: white;",
            "C" => "background-color: #d97706; color: white;",
            _ => "background-color: #ef4444; color: white;"
        };
    }
}
