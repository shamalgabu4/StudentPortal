@{
    ViewData["Title"] = "Student Dashboard";
    var student = ViewBag.StudentProfile as StudentPortal.Models.StudentProfile;
    var notices = ViewBag.Notices as List<StudentPortal.Models.Notice>;
}

<div class="mb-4">
    <h3 class="mb-0">Welcome, @student?.User?.FullName</h3>
    <small class="text-muted">@student?.Branch?.Name • Semester @student?.CurrentSemester?.SemesterNumber</small>
</div>

<div class="row mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-megaphone"></i> Announcements & Notices</h6>
            </div>
            <div class="card-body">
                @if (notices?.Any() ?? false)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var notice in notices)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@notice.Title</h6>
                                        <p class="mb-2 text-muted small">@notice.Content</p>
                                        <small class="text-muted">
                                            <span class="badge bg-light text-dark me-2">@notice.Category</span>
                                            @notice.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox" style="font-size:32px;display:block;margin-bottom:1rem;opacity:0.5"></i>
                        <p>No announcements yet</p>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Quick Info</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">Roll Number</small>
                    <p class="mb-2"><strong>@student?.RollNumber</strong></p>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Email</small>
                    <p class="mb-2"><strong>@student?.Email</strong></p>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Branch</small>
                    <p class="mb-2"><strong>@student?.Branch?.Name</strong></p>
                </div>
                <div>
                    <small class="text-muted">Current Semester</small>
                    <p class="mb-0"><strong>@student?.CurrentSemester?.SemesterNumber</strong></p>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Quick Actions</h6>
            </div>
            <div class="card-body">
                <a href="@Url.Action("Results", "StudentDashboard")" class="btn btn-sm btn-primary d-block mb-2"><i class="bi bi-file-earmark-text"></i> View Results</a>
                <a href="@Url.Action("Create", "Feedback")" class="btn btn-sm btn-outline-primary d-block"><i class="bi bi-chat-left-text"></i> Send Feedback</a>
            </div>
        </div>
    </div>
</div>
