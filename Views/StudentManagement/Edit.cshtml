@model StudentPortal.Models.StudentProfile
@{
    ViewData["Title"] = "Edit Student";
}

<div class="mb-4">
    <h3 class="mb-0">Edit Student</h3>
    <small class="text-muted">Update student profile and assignment</small>
</div>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="StudentProfileId" />

            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Student Details</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 form-floating">
                            <input type="text" asp-for="RollNumber" class="form-control" placeholder="Roll Number" required />
                            <label asp-for="RollNumber">Roll Number</label>
                            <span asp-validation-for="RollNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input type="email" asp-for="Email" class="form-control" placeholder="Email" required />
                            <label asp-for="Email">Email</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input type="text" asp-for="PhoneNumber" class="form-control" placeholder="Phone" required pattern="[0-9]{10}" />
                            <label asp-for="PhoneNumber">Phone (10 digits)</label>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input type="date" asp-for="DateOfBirth" class="form-control" required />
                            <label asp-for="DateOfBirth">Date of Birth</label>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-floating">
                            <select asp-for="BranchId" class="form-select" required asp-items="@(new SelectList(ViewBag.Branches, "BranchId", "Name"))">
                                <option selected disabled>-- Select Branch --</option>
                            </select>
                            <label asp-for="BranchId">Branch</label>
                            <span asp-validation-for="BranchId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-floating">
                            <select asp-for="CurrentSemesterId" class="form-select" required asp-items="@(new SelectList(ViewBag.Semesters, "SemesterId", "SemesterNumber"))">
                                <option selected disabled>-- Select Semester --</option>
                            </select>
                            <label asp-for="CurrentSemesterId">Current Semester</label>
                            <span asp-validation-for="CurrentSemesterId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveCheck" />
                                <label class="form-check-label" for="isActiveCheck">Active (Student can login)</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Update Student</button>
                <a class="btn btn-secondary" asp-action="Index">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
