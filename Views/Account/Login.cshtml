@model StudentPortal.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:70vh">
    <div class="card" style="max-width:420px;width:100%">
        <div class="card-body">
            <h4 class="mb-3">Sign in to your account</h4>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid?"none":"block")"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Email" />
                    <label asp-for="Email">Email</label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                    <label asp-for="Password">Password</label>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label class="form-check-label">Remember me</label>
                    </div>
                    <input type="hidden" asp-for="ReturnUrl" />
                </div>
                <div class="d-grid">
                    <button class="btn btn-primary">Sign in</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{<partial name="_ValidationScriptsPartial" />}
