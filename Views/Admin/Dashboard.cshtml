@model List<StudentPortal.Models.Notice>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-speedometer2"></i> Dashboard</h2>
        <p class="text-muted mb-0">Welcome back, <strong>@User?.Identity?.Name</strong></p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Students</div>
                    <div class="stat-number">@ViewBag.TotalStudents</div>
                    <small class="text-muted">Registered in system</small>
                </div>
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="stat-card success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Active Students</div>
                    <div class="stat-number">@ViewBag.ActiveStudents</div>
                    <small class="text-muted">Enrolled this semester</small>
                </div>
                <div class="stat-icon"><i class="bi bi-person-check-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Feedback</div>
                    <div class="stat-number">@ViewBag.TotalFeedback</div>
                    <small class="text-muted">From students</small>
                </div>
                <div class="stat-icon"><i class="bi bi-chat-left-text-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="stat-card info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Active Notices</div>
                    <div class="stat-number">@ViewBag.ActiveNotices</div>
                    <small class="text-muted">Latest announcements</small>
                </div>
                <div class="stat-icon"><i class="bi bi-megaphone-fill"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Notices -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-megaphone"></i> Recent Notices</h5>
                    <a href="@Url.Action("Manage", "Notice")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var notice in Model.Take(5))
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 font-weight-600">@notice.Title</h6>
                                        <p class="mb-2 text-muted">@notice.Content.Substring(0, Math.Min(120, notice.Content.Length))...</p>
                                        <small>
                                            <span class="badge bg-light text-dark">@notice.Category</span>
                                            <span class="text-muted ms-2"><i class="bi bi-calendar3"></i> @notice.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox" style="font-size:2rem;opacity:0.3"></i>
                        <p class="mt-2">No notices published yet</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Create", "StudentManagement")" class="btn btn-primary btn-sm">
                        <i class="bi bi-person-plus"></i> Add New Student
                    </a>
                    <a href="@Url.Action("Index", "MarksManagement")" class="btn btn-primary btn-sm">
                        <i class="bi bi-file-earmark-text"></i> Manage Marks
                    </a>
                    <a href="@Url.Action("Manage", "Notice")" class="btn btn-primary btn-sm">
                        <i class="bi bi-megaphone"></i> Post Notice
                    </a>
                    <a href="@Url.Action("Index", "Feedback")" class="btn btn-primary btn-sm">
                        <i class="bi bi-chat-left-text"></i> View Feedback
                    </a>
                </div>
            </div>
        </div>

        <!-- System Status -->
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> System Status</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <small class="text-muted">Database</small>
                    <span class="badge bg-success">Online</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Authentication</small>
                    <span class="badge bg-success">Active</span>
                </div>
            </div>
        </div>
    </div>
</div>
                <a href="@Url.Action("Create", "Notice")" class="btn btn-sm btn-primary d-block mb-2"><i class="bi bi-megaphone"></i> Create Notice</a>
                <a href="@Url.Action("Index", "MarksManagement")" class="btn btn-sm btn-primary d-block"><i class="bi bi-file-earmark-text"></i> Manage Marks</a>
            </div>
        </div>
    </div>
</div>
