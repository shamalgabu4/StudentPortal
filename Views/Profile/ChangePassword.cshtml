@model StudentPortal.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-lock"></i> Change Password</h2>
            <hr />
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0">Update Your Password</h5>
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post" id="changePasswordForm">
                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label">Current Password <span class="text-danger">*</span></label>
                            <input asp-for="OldPassword" type="password" class="form-control" id="oldPassword" />
                            <span asp-validation-for="OldPassword" class="text-danger small" id="oldPasswordError"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">New Password <span class="text-danger">*</span></label>
                            <input asp-for="NewPassword" type="password" class="form-control" id="newPassword" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <small class="text-muted">Minimum 6 characters</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm New Password <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPassword" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            <div id="passwordMatchError" class="text-danger small mt-1" style="display:none">
                                Passwords do not match.
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Password requirements:
                            <ul class="mb-0 mt-2">
                                <li>At least 6 characters</li>
                                <li>Must be different from current password</li>
                                <li>Confirm password must match</li>
                            </ul>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" id="changePasswordBtn">Change Password</button>
                            <a href="@Url.Action("Edit")" class="btn btn-secondary">Back to Profile</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Improved client-side validation to avoid unnecessary full-page submits
        (function(){
            const form = document.getElementById('changePasswordForm');
            const oldPwd = document.getElementById('oldPassword');
            const newPwd = document.getElementById('newPassword');
            const confirmPwd = document.getElementById('confirmPassword');
            const matchError = document.getElementById('passwordMatchError');
            const oldErrSpan = document.getElementById('oldPasswordError');

            function validateFields() {
                let valid = true;
                // clear errors
                if(oldErrSpan) oldErrSpan.textContent = '';
                if(matchError) matchError.style.display = 'none';

                if(!oldPwd || !oldPwd.value.trim()) {
                    if(oldErrSpan) oldErrSpan.textContent = 'Current password is required.';
                    valid = false;
                }

                if(!newPwd || !newPwd.value.trim()) {
                    valid = false;
                }

                if(!confirmPwd || !confirmPwd.value.trim()) {
                    valid = false;
                }

                if(newPwd && confirmPwd && newPwd.value && confirmPwd.value && newPwd.value !== confirmPwd.value) {
                    if(matchError) matchError.style.display = 'block';
                    valid = false;
                }

                return valid;
            }

            form?.addEventListener('submit', function(e){
                if(!validateFields()) {
                    e.preventDefault();
                    return false;
                }
                return true;
            });

            confirmPwd?.addEventListener('input', function(){
                if(matchError) {
                    if(newPwd.value && this.value && newPwd.value !== this.value) matchError.style.display = 'block';
                    else matchError.style.display = 'none';
                }
            });
        })();
    </script>
}
