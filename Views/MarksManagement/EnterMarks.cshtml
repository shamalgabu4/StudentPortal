@{
    ViewData["Title"] = "Enter Marks";
    var semester = ViewBag.Semester as StudentPortal.Models.Semester;
    var student = ViewBag.Student as StudentPortal.Models.StudentProfile;
    var subjects = ViewBag.Subjects as List<StudentPortal.Models.Subject>;
    var existingMarks = ViewBag.ExistingMarks as Dictionary<int, StudentPortal.Models.Marks>;
}

<div class="mb-4">
    <a href="@Url.Action("Index", "MarksManagement")" class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i> Back</a>
    <h3 class="mt-3 mb-0">Enter Marks</h3>
    <small class="text-muted">Semester @semester?.SemesterNumber • @student?.User?.FullName (@student?.RollNumber)</small>
</div>

<form asp-action="SaveMarks" method="post">
    <input type="hidden" name="semesterId" value="@semester?.SemesterId" />
    <input type="hidden" name="studentId" value="@student?.StudentProfileId" />

    <div class="card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Code</th>
                        <th>Max Marks</th>
                        <th>Obtained Marks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subject in subjects ?? new List<StudentPortal.Models.Subject>())
                    {
                        var existingMark = existingMarks?.ContainsKey(subject.SubjectId) == true ? existingMarks[subject.SubjectId].ObtainedMarks : 0;
                        
                        <tr>
                            <td><strong>@subject.Name</strong></td>
                            <td>@subject.Code</td>
                            <td>@subject.MaxMarks</td>
                            <td>
                                <input type="number" name="marks[@subject.SubjectId]" class="form-control form-control-sm" 
                                       min="0" max="@subject.MaxMarks" step="0.5" 
                                       value="@(existingMark > 0 ? existingMark : "")" 
                                       placeholder="0-@subject.MaxMarks" required />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Save Marks</button>
        <a class="btn btn-secondary" asp-action="Index">Back</a>
    </div>
</form>
