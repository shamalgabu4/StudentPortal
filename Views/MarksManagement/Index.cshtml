@model List<StudentPortal.Models.Marks>
@{
    ViewData["Title"] = "Marks Management";
    var semesters = ViewBag.Semesters as List<StudentPortal.Models.Semester>;
    var selectedSemesterId = ViewBag.SelectedSemesterId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-file-earmark-text"></i> Marks Management</h2>
        <small class="text-muted">View and manage student marks across semesters</small>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6 col-lg-4">
                <label for="semesterSelect" class="form-label">Select Semester</label>
                <select name="semesterId" id="semesterSelect" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Select Semester --</option>
                    @foreach (var sem in semesters ?? new List<StudentPortal.Models.Semester>())
                    {
                        <option value="@sem.SemesterId" selected="@(sem.SemesterId == selectedSemesterId)">
                            Semester @sem.SemesterNumber
                        </option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

@if (selectedSemesterId.HasValue && Model.Any())
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Semester Marks Overview</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-hash"></i> Roll Number</th>
                        <th><i class="bi bi-envelope"></i> Student Email</th>
                        <th><i class="bi bi-book"></i> Subjects</th>
                        <th><i class="bi bi-graph-up"></i> Avg Marks</th>
                        <th><i class="bi bi-check-circle"></i> Status</th>
                        <th><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model.GroupBy(m => m.StudentProfileId))
                    {
                        var marks = group.ToList();
                        var student = marks.First().StudentProfile;
                        var avgMarks = marks.Average(m => m.ObtainedMarks);
                        var passCount = marks.Count(m => m.IsPassed);
                        var totalSubjects = marks.Count;
                        var passPercentage = totalSubjects > 0 ? (passCount * 100 / totalSubjects) : 0;
                        var statusColor = passPercentage == 100 ? "success" : passPercentage >= 50 ? "warning" : "danger";
                        var statusText = passPercentage == 100 ? "Passed All" : passPercentage >= 50 ? "Passed" : "Failed";
                        
                        <tr>
                            <td><strong>@student?.RollNumber</strong></td>
                            <td>@student?.User?.Email</td>
                            <td><span class="badge bg-info">@marks.Count</span></td>
                            <td>
                                <span class="font-weight-600">@avgMarks.ToString("F2")</span>
                                <small class="text-muted">/100</small>
                            </td>
                            <td>
                                <span class="badge bg-@statusColor" title="@passCount/@totalSubjects subjects passed">
                                    @statusText
                                </span>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="EnterMarks" asp-route-semesterId="@selectedSemesterId" asp-route-studentId="@student?.StudentProfileId">
                                    <i class="bi bi-pencil"></i> Edit Marks
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (selectedSemesterId.HasValue)
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size:32px;display:block;margin-bottom:1rem;opacity:0.5"></i>
            <p>No marks entered for selected semester</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-info-circle" style="font-size:32px;display:block;margin-bottom:1rem;opacity:0.5"></i>
            <p>Select a semester to view marks</p>
        </div>
    </div>
}
